<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>NT Geo Camera</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>NT Geo Camera</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>NSCameraUsageDescription</key>
    <string>NT Geo Camera uses the camera for photos and full-quality video.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Video recordings include sound from the microphone.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Location is stamped on photos and written into the photo file.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Photos and videos are saved to your library.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
