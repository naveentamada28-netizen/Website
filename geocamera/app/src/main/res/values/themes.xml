<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GeoCamera" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/mint</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="HudButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/hud</item>
        <item name="android:textColor">@color/text</item>
        <item name="rippleColor">@color/amber</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
